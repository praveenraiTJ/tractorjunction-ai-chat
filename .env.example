# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=tractor_junction

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Set to 'true' to disable ChromaDB and use database fallback only
DISABLE_CHROMADB=false

# Server Configuration
PORT=3000
NODE_ENV=development

# Kisan AI agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Mandi prices: free key from https://data.gov.in (My Account → API key)
DATA_GOV_API_KEY=
# Required header x-admin-token for /api/sessions/admin/*
ADMIN_TOKEN=
TJ_SITE_URL=https://www.tractorjunction.com
