{
  "name": "tractor-junction-ai-chat",
  "version": "1.0.0",
  "description": "AI Chat System for Tractor Junction with OpenAI, MySQL, and ChromaDB",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "chromadb": "^1.7.3",
    "chromadb-default-embed": "^2.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "node-cache": "^5.1.2",
    "openai": "^4.20.1",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.14",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "ai",
    "chat",
    "tractor",
    "openai",
    "mysql",
    "chromadb"
  ],
  "author": "Tractor Junction",
  "license": "MIT"
}
